# Pengaturan Direktori Utama Hosting
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect kompatibilitas jika ada request lama yang memanggil folder frontend/
  RewriteRule ^frontend/(.*)$ $1 [R=301,L]
</IfModule>

# Cegah browser menyimpan cache lama saat ada pembaruan kode
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Cegah akses ke berkas sensitif tersembunyi
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
